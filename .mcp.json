{
  "mcpServers": {
    "postgres-server": {
      "type": "stdio",
      "command": "C:/dev/northwind-mcp/.venv/Scripts/python.exe",
      "args": ["C:/dev/northwind-mcp/postgres-mcp-server/main.py"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
